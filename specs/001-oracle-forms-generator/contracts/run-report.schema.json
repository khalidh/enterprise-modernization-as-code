{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oracle Forms generator run report",
  "type": "object",
  "required": ["run_id", "generated_at", "status", "stages", "outputs", "errors"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["success", "failure"] },
    "stages": {
      "type": "object",
      "required": ["yaml_validation", "xml_generation", "xml_validation", "fmb_conversion"],
      "properties": {
        "yaml_validation": { "$ref": "#/$defs/stage" },
        "xml_generation": { "$ref": "#/$defs/stage" },
        "xml_validation": { "$ref": "#/$defs/stage" },
        "fmb_conversion": { "$ref": "#/$defs/stage" }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string", "enum": ["xml", "fmb", "report", "error_log"] },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "unavailable", "not_run"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "stage", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}